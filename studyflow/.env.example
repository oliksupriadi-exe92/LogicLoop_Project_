# ========================================================
# STUDYFLOW - ENVIRONMENT CONFIGURATION TEMPLATE
# ========================================================

# 1. DATABASE CONFIGURATION
# Default menggunakan basis data lokal SQLite (prisma/dev.db)
# Untuk produksi di cloud, ganti dengan URL Supabase/Neon PostgreSQL:
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="file:./dev.db"

# 2. AUTHENTICATION & JWT SECRET
# Digunakan untuk enkripsi token sesi HTTP-Only cookie (minimal 32 karakter)
NEXTAUTH_SECRET="studyflow_super_secret_jwt_key_min_32_characters_long_12345"

# 3. NOTIFIKASI TELEGRAM BOT (OPSIONAL)
# Buat bot melalui @BotFather di Telegram untuk mendapatkan token
TELEGRAM_BOT_TOKEN=""
